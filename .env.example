# =============================================================================
# CrimeNet SA — Environment Variables Template
# File: .env.example
# Copy to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (get from supabase.com dashboard → Settings → API)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate a strong random string: openssl rand -hex 64
JWT_SECRET=your-super-long-random-jwt-secret

# ---------------------------------------------------------------------------
# WhatsApp Business API (get from Meta Developer Console)
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Make up your own verify token — used to verify Meta webhook
WHATSAPP_VERIFY_TOKEN=crimenet-webhook-verify-token-2026

# ---------------------------------------------------------------------------
# Anthropic Claude API (ai.anthropic.com → API Keys)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---------------------------------------------------------------------------
# Mapbox (account.mapbox.com → Tokens)
# ---------------------------------------------------------------------------
MAPBOX_TOKEN=pk.eyJ1...your-mapbox-public-token
# Next.js public env vars (prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...your-mapbox-public-token
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# Inter-service communication
# ---------------------------------------------------------------------------
# Generate a strong random string: openssl rand -hex 32
AI_SERVICE_API_KEY=your-internal-ai-service-api-key
AI_SERVICE_URL=http://localhost:8000  # or Railway URL in prod

# ---------------------------------------------------------------------------
# Vonage (SMS OTP for phone auth)
# ---------------------------------------------------------------------------
VONAGE_API_KEY=your-vonage-api-key
VONAGE_API_SECRET=your-vonage-api-secret

# ---------------------------------------------------------------------------
# Firebase (Push Notifications)
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_SERVICE_ACCOUNT_KEY='{...json key...}'

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
API_URL=http://localhost:3001         # NestJS API
WEB_DASHBOARD_URL=http://localhost:3000  # Next.js dashboard
EXPO_PUBLIC_API_URL=http://localhost:3001  # Mobile app → API

# ---------------------------------------------------------------------------
# Sentry (Error tracking — free tier)
# ---------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
